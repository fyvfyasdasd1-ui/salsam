<Application x:Class="Salsam.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Accent" Color="#8B9DFF"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E4E9F5"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style TargetType="Button"><Setter Property="Background" Value="#28344F"/><Setter Property="Foreground" Value="#F0F3FF"/><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,6,10,6"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#425681"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#172136"/><Setter Property="Foreground" Value="#E4E9F5"/><Setter Property="CaretBrush" Value="White"/><Setter Property="Padding" Value="12"/><Setter Property="BorderBrush" Value="#344363"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E4E9F5"/><Setter Property="Margin" Value="0,8"/></Style>
    <Style TargetType="ListBox"><Setter Property="Background" Value="#141D30"/><Setter Property="Foreground" Value="#E4E9F5"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
    <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="12"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
  </Application.Resources>
</Application>
