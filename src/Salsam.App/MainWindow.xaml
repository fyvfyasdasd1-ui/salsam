<Window x:Class="Salsam.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Salsam.App"
        Title="Salsam 2.0 · Настройте Windows под себя" Width="1400" Height="900"
        MinWidth="1050" MinHeight="650" Background="#0D1220" Foreground="#EDF0FA"
        FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <local:SectionVisibility x:Key="SectionVisibility"/>
    <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource CardTitle}"><Setter Property="FontSize" Value="20"/><Setter Property="Margin" Value="0,8,0,15"/></Style>
    <Style x:Key="NavigationItem" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="13,13"/><Setter Property="Margin" Value="0,0,0,5"/><Setter Property="Foreground" Value="#919DB9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="NavSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Stretch"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavSurface" Property="Background" Value="#1A2136"/><Setter Property="Foreground" Value="#E2DDF3"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="NavSurface" Property="Background" Value="#2B2446"/><Setter TargetName="NavSurface" Property="BorderBrush" Value="#42325F"/><Setter Property="Foreground" Value="#C9B7FF"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NavSurface" Property="BorderBrush" Value="#8A70D5"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="NavIcon" TargetType="TextBlock">
      <Setter Property="Text" Value="&#xE713;"/><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="16"/><Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding}" Value="Обзор"><Setter Property="Text" Value="&#xE80F;"/></DataTrigger>
        <DataTrigger Binding="{Binding}" Value="Игры"><Setter Property="Text" Value="&#xE7FC;"/></DataTrigger>
        <DataTrigger Binding="{Binding}" Value="Автозагрузка"><Setter Property="Text" Value="&#xE7F8;"/></DataTrigger>
        <DataTrigger Binding="{Binding}" Value="Очистка"><Setter Property="Text" Value="&#xE74D;"/></DataTrigger>
        <DataTrigger Binding="{Binding}" Value="Мониторинг"><Setter Property="Text" Value="&#xE9D9;"/></DataTrigger>
        <DataTrigger Binding="{Binding}" Value="Восстановление"><Setter Property="Text" Value="&#xE777;"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Padding" Value="16"/><Setter Property="Margin" Value="0,0,10,12"/></Style>
    <Style x:Key="MetricLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,9"/></Style>
    <Style x:Key="DetailLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,12,0,4"/></Style>
  </Window.Resources>
  <Window.Triggers><EventTrigger RoutedEvent="Window.Loaded"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.24"/></Storyboard></BeginStoryboard></EventTrigger></Window.Triggers>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="196"/><ColumnDefinition Width="*"/><ColumnDefinition Width="288"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#101625" BorderBrush="#242B40" BorderThickness="0,0,1,0" Padding="15,25,15,18">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Margin="7,0,0,29">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="34" Height="34" CornerRadius="10" Margin="0,0,9,0">
              <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#B39AFF" Offset="0"/><GradientStop Color="#7953D6" Offset="1"/></LinearGradientBrush></Border.Background>
              <Viewbox Width="20" Height="22"><Path Data="M 13,0 L 3,13 L 10,13 L 7,25 L 21,9 L 13,9 Z" Fill="White"/></Viewbox>
            </Border>
            <TextBlock Text="salsam" FontWeight="Bold" FontSize="25" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,13,0,0"><TextBlock Text="WINDOWS OPTIMIZER" FontSize="8" Foreground="#74809F" VerticalAlignment="Center"/><Border Background="#252039" CornerRadius="4" Padding="6,2" Margin="8,0,0,0"><TextBlock Text="2.0" FontSize="9" Foreground="#B69DFA"/></Border></StackPanel>
        </StackPanel>
        <Border DockPanel.Dock="Bottom" Background="#161E30" BorderBrush="#29344A" BorderThickness="1" CornerRadius="12" Padding="13" Margin="0,20,0,0">
          <StackPanel><TextBlock Text="Настройки под контролем" FontWeight="SemiBold" FontSize="11" Foreground="#71DAC5" Margin="0,0,0,6"/><TextBlock Text="Предпросмотр, журнал и отдельный откат каждого изменения." Style="{StaticResource Caption}" FontSize="10" LineHeight="16"/></StackPanel>
        </Border>
        <StackPanel><TextBlock Text="РАБОЧЕЕ ПРОСТРАНСТВО" FontSize="9" Foreground="#616F91" FontWeight="SemiBold" Margin="12,0,0,14"/>
          <ListBox ItemsSource="{Binding Sections}" SelectedItem="{Binding Section, Mode=TwoWay}" ItemContainerStyle="{StaticResource NavigationItem}" AutomationProperties.AutomationId="Navigation">
            <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="29"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource NavIcon}"/><TextBlock Grid.Column="1" Text="{Binding}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" Margin="25,26,21,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,22">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="{Binding Section}" FontSize="28" FontWeight="SemiBold" AutomationProperties.AutomationId="SectionTitle"/><TextBlock Text="Настройте Windows под свой сценарий." Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel>
        <Border Grid.Column="1" Background="#151E30" BorderBrush="#2B374E" BorderThickness="1" CornerRadius="8" Padding="11,7" VerticalAlignment="Top" Margin="12,5,0,0"><TextBlock Text="Windows 10 / 11" FontSize="10" Foreground="#A6B4CA"/></Border>
      </Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,5,20" AutomationProperties.AutomationId="Content">
        <StackPanel>
          <!-- Overview: the main actions, real measurements, and reusable profiles. -->
          <StackPanel Visibility="{Binding Section, Converter={StaticResource SectionVisibility}, ConverterParameter=Обзор}">
            <Border CornerRadius="18" BorderBrush="#51406F" BorderThickness="1" Padding="24" Margin="0,0,0,20">
              <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#30234F" Offset="0"/><GradientStop Color="#1A243D" Offset="1"/></LinearGradientBrush></Border.Background>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><Border Style="{StaticResource Tag}" HorizontalAlignment="Left" Background="#493662" Margin="0,0,0,13"><TextBlock Text="ВАШ КОМПЬЮТЕР. ВАШИ ПРАВИЛА." FontSize="9" Foreground="#D4C4FA" FontWeight="SemiBold"/></Border>
                  <TextBlock Text="Больше контроля.&#x0a;Меньше лишнего." FontSize="29" FontWeight="SemiBold" LineHeight="35"/>
                  <TextBlock Text="{Binding AnalysisSummary}" Foreground="#BDB4D3" LineHeight="21" Margin="0,14,16,0"/>
                  <Button Content="Анализировать систему" Command="{Binding AnalyzeCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,19,0,0"/>
                  <TextBlock Text="{Binding LastScan}" FontSize="10" Foreground="#A09AB8" Margin="0,10,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#251E3B" BorderBrush="#514273" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,38,0,0" VerticalAlignment="Top" Width="108">
                  <StackPanel><TextBlock Text="{Binding RecommendationCount}" FontSize="36" Foreground="#C1A7FF" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="изменений для&#x0a;профиля «Игры»" FontSize="10" TextAlignment="Center" Foreground="#AE9CCF" Margin="0,6,0,0"/></StackPanel>
                </Border>
              </Grid>
            </Border>
            <UniformGrid Columns="2" Margin="0,0,-10,4">
              <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="ПРОЦЕССОР" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding Cpu}" FontSize="27" FontWeight="SemiBold" Foreground="#B69BFF"/><ProgressBar Value="{Binding CpuPercent, Mode=OneWay}" Margin="0,12,0,9"/><TextBlock Text="{Binding CpuName}" Style="{StaticResource Caption}"/></StackPanel></Border>
              <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="ОПЕРАТИВНАЯ ПАМЯТЬ" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding Ram}" FontSize="20" FontWeight="SemiBold" Foreground="#71DDCB"/><ProgressBar Value="{Binding RamPercent, Mode=OneWay}" Foreground="{StaticResource Cyan}" Margin="0,12,0,9"/><TextBlock Text="{Binding RamTotal}" Style="{StaticResource Caption}"/></StackPanel></Border>
              <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="ВИДЕОКАРТА" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding GpuName}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Gpu}" Style="{StaticResource Caption}" Margin="0,9,0,0"/></StackPanel></Border>
              <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="ПИТАНИЕ" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding ActivePower}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding PowerSource}" Style="{StaticResource Caption}" Margin="0,9,0,0"/></StackPanel></Border>
            </UniformGrid>
            <TextBlock Text="Профили оптимизации" Style="{StaticResource SectionTitle}"/>
            <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,10,0"><StackPanel><TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="21" Foreground="#65D8C4" Margin="0,0,0,13"/><TextBlock Text="Сбалансированный" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBlock Text="Схема: сбалансированная&#x0a;Анимации: включены" Style="{StaticResource Caption}" FontSize="11"/><Button Content="В очередь" Command="{Binding BalancedCommand}" Margin="0,17,0,0"/></StackPanel></Border>
              <Border Grid.Column="1" Style="{StaticResource Card}" BorderBrush="#5B4580" Background="#201C34" Padding="14" Margin="0,0,10,0"><StackPanel><TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="21" Foreground="#B99CFF" Margin="0,0,0,13"/><TextBlock Text="Игры" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBlock Text="Схема: высокая производительность*&#x0a;Анимации: выключены" Style="{StaticResource Caption}" FontSize="11"/><Button Content="В очередь" Command="{Binding GamingCommand}" Style="{StaticResource PrimaryButton}" Margin="0,17,0,0"/></StackPanel></Border>
              <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14" Margin="0"><StackPanel><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="21" Foreground="#90ADEA" Margin="0,0,0,13"/><TextBlock Text="Свой профиль" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBlock Text="Выберите настройки в каталоге и сохраните свою очередь." Style="{StaticResource Caption}" FontSize="11"/><Button Content="Настроить" Command="{Binding CustomCommand}" Margin="0,17,0,0"/></StackPanel></Border>
            </Grid>
            <TextBlock Text="* Используется существующая схема Windows. На ноутбуке учитывайте расход батареи и нагрев. Профили не гарантируют прирост FPS. Любое действие можно исключить в очереди." Style="{StaticResource Caption}" Margin="0,0,0,18"/>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Сохранить свою конфигурацию" Style="{StaticResource CardTitle}"/><TextBlock Text="Сохраняются выбранные настройки интерфейса и питания из очереди. Загрузка профиля показывает изменения для проверки перед применением." Style="{StaticResource Caption}" Margin="0,0,0,14"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Название вашего профиля" AutomationProperties.Name="Название профиля"/><Button Grid.Column="1" Content="Сохранить" Command="{Binding SaveProfileCommand}" Margin="9,0,0,0"/><Button Grid.Column="2" Content="Загрузить" Command="{Binding LoadProfileCommand}" Style="{StaticResource QuietButton}" Margin="9,0,0,0"/></Grid>
              <TextBlock Text="{Binding ProfileStatus}" Style="{StaticResource Caption}" Foreground="#A995DB" Margin="0,11,0,0"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Конфигурация компьютера" Style="{StaticResource CardTitle}"/><TextBlock Text="{Binding WindowsName}" Style="{StaticResource Body}"/><Expander Header="Оборудование, диски и версии драйверов" Margin="0,10,0,0"><TextBlock Text="{Binding Hardware}" FontFamily="Consolas" FontSize="11" Foreground="#A4B2CE" Margin="0,12,0,0"/></Expander></StackPanel></Border>
          </StackPanel>

          <!-- Only the optimization page contains the searchable setting catalog. -->
          <StackPanel Visibility="{Binding Section, Converter={StaticResource SectionVisibility}, ConverterParameter=Оптимизация}">
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Выбирайте осознанно" Style="{StaticResource CardTitle}"/><TextBlock Text="Отметьте нужные настройки и добавьте их в очередь. Для каждого изменения указаны эффект, компромиссы и исходное состояние. Применение — после отдельного подтверждения." Style="{StaticResource Body}"/></StackPanel></Border>
            <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
              <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Поиск по названию, описанию и состоянию" AutomationProperties.Name="Поиск настроек" Padding="34,11,12,11"/>
              <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="#7483A6" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"/>
              <ComboBox Grid.Column="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" Margin="10,0,0,0" ToolTip="Категория настроек" AutomationProperties.Name="Категория настроек"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding FilteredOptimizations}">
              <ItemsControl.Style><Style TargetType="ItemsControl"><Style.Triggers><DataTrigger Binding="{Binding Busy}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></ItemsControl.Style>
              <ItemsControl.ItemTemplate><DataTemplate>
              <Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource Card}"><Style.Triggers><DataTrigger Binding="{Binding IsAvailable}" Value="False"><Setter Property="Opacity" Value="0.68"/></DataTrigger></Style.Triggers></Style></Border.Style>
                <StackPanel>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding IsAvailable}" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"/></CheckBox>
                    <Border Grid.Column="1" Style="{StaticResource Tag}" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding Category}" FontSize="9" Foreground="#BCA9E9"/></Border>
                  </Grid>
                  <TextBlock Text="{Binding Description}" Style="{StaticResource Body}" Margin="0,13,0,0"/>
                  <TextBlock Text="ОЖИДАЕМЫЙ ЭФФЕКТ" Style="{StaticResource DetailLabel}"/><TextBlock Text="{Binding Effect}" Foreground="#69D8C2" FontSize="12" LineHeight="19"/>
                  <TextBlock Text="ЧТО УЧЕСТЬ" Style="{StaticResource DetailLabel}"/><TextBlock Text="{Binding Tradeoff}" Foreground="#CCAD83" FontSize="12" LineHeight="19"/>
                  <Border Background="#101626" CornerRadius="8" Padding="12" Margin="0,15,0,0"><StackPanel><TextBlock Text="{Binding State}" FontSize="12" Foreground="#AAB8D3"/><TextBlock Text="{Binding Restart}" Style="{StaticResource Caption}" FontSize="10" Margin="0,5,0,0"/></StackPanel></Border>
                </StackPanel>
              </Border>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <Button Content="Выбранные настройки → в очередь" Command="{Binding QueueSelectedCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,0,0,22"/>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Выбрать схему питания" Style="{StaticResource CardTitle}"/><TextBlock Text="{Binding ActivePower}" Foreground="#BCA9F5" FontWeight="SemiBold" Margin="0,0,0,12"/>
              <ComboBox ItemsSource="{Binding Plans}" SelectedItem="{Binding SelectedPlan, Mode=TwoWay}" ToolTip="Существующие схемы питания Windows" AutomationProperties.Name="Схема питания"/>
              <TextBlock Text="Меняется политика энергопотребления Windows. Более агрессивная схема может повысить температуру, шум и расход батареи. Автоматический контроль температуры не реализован. Перезагрузка не нужна." Style="{StaticResource Caption}" Margin="0,13,0,15"/>
              <Button Content="Схему питания → в очередь" Command="{Binding QueuePowerCommand}" HorizontalAlignment="Left"/>
            </StackPanel></Border>
          </StackPanel>

          <StackPanel Visibility="{Binding Section, Converter={StaticResource SectionVisibility}, ConverterParameter=Игры}">
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Настройки игры в Windows" Style="{StaticResource CardTitle}"/><TextBlock Text="Проверьте игровой режим и фоновую запись через штатные настройки Windows. Автоматическое чтение этих состояний и управление сторонними оверлеями пока недоступны." Style="{StaticResource Body}"/>
              <WrapPanel Margin="0,17,0,13"><Button Content="Игровой режим ↗" Command="{Binding GameSettingsCommand}" Margin="0,0,10,8"/><Button Content="Запись игры ↗" Command="{Binding CaptureSettingsCommand}" Margin="0,0,0,8"/></WrapPanel>
              <TextBlock Text="Отключение записи убирает возможность сохранить предыдущие моменты игры. Ручные изменения в Windows не попадают в журнал Salsam." Style="{StaticResource Caption}"/>
            </StackPanel></Border>
            <TextBlock Text="Производительность: до и после" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Импортируйте реальные измерения одной игры или процесса. Сравнивайте одинаковую сцену, разрешение, графику и условия прогрева." Style="{StaticResource Body}" Margin="0,0,0,16"/>
            <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Style="{StaticResource Card}" BorderBrush="#504073" Margin="0,0,10,0"><StackPanel><TextBlock Text="ДО ИЗМЕНЕНИЙ" Style="{StaticResource MetricLabel}" Foreground="#BBA1F5"/><TextBlock Text="{Binding Before}" FontSize="16" FontWeight="SemiBold" LineHeight="24"/><Button Content="Импорт CSV · до" Command="{Binding ImportBeforeCommand}" Margin="0,16,0,0"/></StackPanel></Border>
              <Border Grid.Column="1" Style="{StaticResource Card}" BorderBrush="#2E625D" Margin="0"><StackPanel><TextBlock Text="ПОСЛЕ ИЗМЕНЕНИЙ" Style="{StaticResource MetricLabel}" Foreground="#6CDBCA"/><TextBlock Text="{Binding After}" FontSize="16" FontWeight="SemiBold" LineHeight="24"/><Button Content="Импорт CSV · после" Command="{Binding ImportAfterCommand}" Margin="0,16,0,0"/></StackPanel></Border>
            </Grid>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Время кадра" Style="{StaticResource CardTitle}"/>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,16"><Ellipse Width="6" Height="6" Fill="#B69BFF" VerticalAlignment="Center"/><TextBlock Text="До" FontSize="11" Foreground="#B69BFF" Margin="6,0,17,0"/><Ellipse Width="6" Height="6" Fill="#59DCC8" VerticalAlignment="Center"/><TextBlock Text="После" FontSize="11" Foreground="#59DCC8" Margin="6,0,0,0"/></StackPanel>
              <Border Background="#0E1423" CornerRadius="10" Padding="12"><Viewbox Stretch="Fill" Height="195"><Canvas Width="600" Height="170"><Line X1="0" X2="600" Y1="5" Y2="5" Stroke="#273149" StrokeThickness="0.7"/><Line X1="0" X2="600" Y1="82" Y2="82" Stroke="#273149" StrokeThickness="0.7"/><Line X1="0" X2="600" Y1="160" Y2="160" Stroke="#35405A" StrokeThickness="0.7"/><Polyline Points="{Binding BeforePoints}" Stroke="#B69BFF" StrokeThickness="1.4"/><Polyline Points="{Binding AfterPoints}" Stroke="#59DCC8" StrokeThickness="1.4"/></Canvas></Viewbox></Border>
              <TextBlock Text="{Binding GraphScale}" Style="{StaticResource Caption}" Margin="0,12,0,0"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Как получить корректное сравнение" Style="{StaticResource CardTitle}"/><TextBlock Text="CSV: столбец FrameTimeMs или MsBetweenPresents, миллисекунды с точкой, не менее 100 кадров. Поддерживаются поля в кавычках; записи с разными ProcessID отклоняются. Захват FPS в реальном времени здесь не реализован." Style="{StaticResource Body}"/><TextBlock Text="Средний FPS = 1000 / среднее время кадра. 1% low = 1000 / среднее время самых медленных 1% кадров. Разница между записями сама по себе не доказывает эффект оптимизации." Style="{StaticResource Caption}" Margin="0,11,0,0"/></StackPanel></Border>
          </StackPanel>

          <StackPanel Visibility="{Binding Section, Converter={StaticResource SectionVisibility}, ConverterParameter=Автозагрузка}">
            <Border Style="{StaticResource Card}"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="При входе в систему" Style="{StaticResource CardTitle}"/><Border Grid.Column="1" Style="{StaticResource Tag}" VerticalAlignment="Top"><TextBlock Text="{Binding StartupCount, StringFormat={}{0} записей}" FontSize="10" Foreground="#BCA9E9"/></Border></Grid>
              <TextBlock Text="Записи Run текущего пользователя. Выберите программу, которую хотите исключить из автозагрузки. Работающий процесс останется запущенным." Style="{StaticResource Body}" Margin="0,0,0,16"/>
              <ListBox ItemsSource="{Binding Startup}" SelectedItem="{Binding SelectedStartup, Mode=TwoWay}" MaxHeight="430"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding Publisher, StringFormat=Издатель: {0}}" Style="{StaticResource Caption}" Margin="0,5,0,0"/><TextBlock Text="{Binding Purpose}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Command}" FontSize="10" Foreground="#727F9D" Margin="0,7,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
              <TextBlock Text="Если список пуст, управляемых записей не найдено. Издатель считывается из файла и не подтверждает доверенность. Отключение может убрать уведомления и фоновые функции программы." Style="{StaticResource Caption}" Margin="0,14,0,16"/>
              <Button Content="Отключить выбранную → в очередь" Command="{Binding QueueStartupCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
              <Button Content="Все приложения в Windows ↗" Command="{Binding StartupSettingsCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
            </StackPanel></Border>
          </StackPanel>

          <StackPanel Visibility="{Binding Section, Converter={StaticResource SectionVisibility}, ConverterParameter=Очистка}">
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Сначала просмотр, затем решение" Style="{StaticResource CardTitle}"/><TextBlock Text="Только файлы верхнего уровня пользовательской временной папки старше 7 дней. Личные документы, сохранения, подкаталоги и кэши шейдеров не обходятся." Style="{StaticResource Body}"/>
              <Button Content="Просканировать временную папку" Command="{Binding ScanCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,17,0,0"/>
              <TextBlock Text="{Binding TempSummary}" Foreground="#71D8C6" FontWeight="SemiBold" Margin="0,16,0,14"/>
              <ListBox ItemsSource="{Binding Temps}" SelectedItem="{Binding SelectedTemp, Mode=TwoWay}" MaxHeight="390"/>
              <Button Content="Выбранный файл → в карантин" Command="{Binding QueueTempCommand}" HorizontalAlignment="Left" Margin="0,15,0,0"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}" Background="#1C2030" BorderBrush="#4D4438"><StackPanel><TextBlock Text="Карантин с возможностью возврата" Style="{StaticResource CardTitle}" Foreground="#DBC297"/><TextBlock Text="Файлы перемещаются в карантин с проверкой целостности. На том же диске карантин не освобождает место. Необратимое удаление не реализовано, занятые файлы не удаляются принудительно." Style="{StaticResource Body}"/><TextBlock Text="Вернуть файл можно в разделе «Восстановление»." Style="{StaticResource Caption}" Margin="0,11,0,0"/></StackPanel></Border>
          </StackPanel>

          <StackPanel Visibility="{Binding Section, Converter={StaticResource SectionVisibility}, ConverterParameter=Мониторинг}">
            <Border Style="{StaticResource Card}"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Показатели системы" Style="{StaticResource CardTitle}"/><Border Grid.Column="1" Style="{StaticResource Tag}" Background="#163B37" VerticalAlignment="Top"><TextBlock Text="ОБНОВЛЕНИЕ · 2 С" FontSize="9" Foreground="#74DACA"/></Border></Grid><TextBlock Text="Загрузка CPU, GPU, физической памяти и диска — когда счётчики доступны в Windows." Style="{StaticResource Caption}"/></StackPanel></Border>
            <UniformGrid Columns="2" Margin="0,0,-10,0">
              <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="ПРОЦЕССОР" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding Cpu}" FontSize="37" Foreground="#B69BFF" FontWeight="SemiBold" AutomationProperties.AutomationId="CpuValue"/><ProgressBar Value="{Binding CpuPercent, Mode=OneWay}" Margin="0,18,0,12"/><TextBlock Text="{Binding CpuName}" Style="{StaticResource Caption}"/></StackPanel></Border>
              <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="ОПЕРАТИВНАЯ ПАМЯТЬ" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding Ram}" FontSize="24" Foreground="#65DACA" FontWeight="SemiBold" AutomationProperties.AutomationId="RamValue"/><ProgressBar Value="{Binding RamPercent, Mode=OneWay}" Foreground="{StaticResource Cyan}" Margin="0,18,0,12"/><TextBlock Text="{Binding RamTotal}" Style="{StaticResource Caption}"/></StackPanel></Border>
              <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="ВИДЕОКАРТА" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding Gpu}" FontSize="23" Foreground="#91B4F1" FontWeight="SemiBold"/><ProgressBar Value="{Binding GpuPercent, Mode=OneWay}" Foreground="#82ACEE" Margin="0,18,0,12"/><TextBlock Text="{Binding GpuName}" Style="{StaticResource Caption}"/></StackPanel></Border>
              <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="ДИСК: ЧТЕНИЕ И ЗАПИСЬ" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding Disk}" FontSize="23" Foreground="#D7B880" FontWeight="SemiBold"/><TextBlock Text="Суммарная скорость операций физических дисков." Style="{StaticResource Caption}" Margin="0,17,0,0"/></StackPanel></Border>
            </UniformGrid>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="FPS и температура" Style="{StaticResource CardTitle}"/><TextBlock Text="Живой захват FPS, времени кадра и температуры не реализован. Для сравнения игровой производительности импортируйте реальные измерения в разделе «Игры». Недоступный счётчик не заменяется примерными значениями." Style="{StaticResource Body}"/></StackPanel></Border>
          </StackPanel>

          <StackPanel Visibility="{Binding Section, Converter={StaticResource SectionVisibility}, ConverterParameter=Восстановление}">
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="История изменений" Style="{StaticResource CardTitle}"/><TextBlock Text="Исходные значения сохраняются до применения. Откат проверяет текущее состояние и останавливается при конфликте с внешними изменениями." Style="{StaticResource Body}" Margin="0,0,0,17"/>
              <ListBox ItemsSource="{Binding History}" SelectedItem="{Binding SelectedRecord, Mode=TwoWay}" MaxHeight="400"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Target}" FontSize="13" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,7,0,0"><TextBlock Text="{Binding Status}" Foreground="#B69BFF" FontSize="11"/><TextBlock Text="{Binding Created}" Foreground="#7F8DAA" FontSize="10" Margin="12,0,0,0"/></StackPanel><TextBlock Text="{Binding Error}" Foreground="#EAA996" FontSize="11" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
              <WrapPanel Margin="0,15,0,0"><Button Content="Восстановить выбранное" Command="{Binding RestoreCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,8"/><Button Content="Вернуть исходные значения" Command="{Binding RestoreAllCommand}" Style="{StaticResource QuietButton}" Margin="0,0,0,8"/></WrapPanel>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Точки восстановления Windows" Style="{StaticResource CardTitle}"/><TextBlock Text="Дополнительная проверка наличия точек. Создание и системное восстановление здесь не выполняются. Основной способ возврата — журнал отдельных изменений." Style="{StaticResource Body}"/><Button Content="Проверить доступность" Command="{Binding RestorePointCommand}" HorizontalAlignment="Left" Margin="0,16,0,0"/><TextBlock Text="{Binding RestoreStatus}" Style="{StaticResource Caption}" Margin="0,13,0,0"/></StackPanel></Border>
            <TextBlock Text="Журнал и карантин находятся в %LOCALAPPDATA%\Salsam. Сохраняйте эту папку, если нужен откат." Style="{StaticResource Caption}"/>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Border Grid.Column="2" Background="#111827" BorderBrush="#252E43" BorderThickness="1,0,0,0" Padding="18,29,18,20">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="План изменений" FontSize="18" FontWeight="SemiBold" AutomationProperties.AutomationId="ChangeQueue"/><Border Grid.Column="1" Background="#2B2542" CornerRadius="6" Padding="8,3"><TextBlock Text="{Binding Pending.Count}" Foreground="#C3AFF4" FontSize="11" FontWeight="SemiBold"/></Border></Grid>
          <TextBlock Text="Проверьте список перед применением. Снимите галочку, чтобы исключить действие." Style="{StaticResource Caption}" FontSize="11" Margin="0,11,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1">
          <Border VerticalAlignment="Top" Background="#151E30" BorderBrush="#29344B" BorderThickness="1" CornerRadius="12" Padding="18"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Pending.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
            <StackPanel><TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="25" Foreground="#617294" HorizontalAlignment="Center" Margin="0,3,0,13"/><TextBlock Text="Очередь пока пуста" TextAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#B5C0D6"/><TextBlock Text="Выберите профиль или добавьте настройки из каталога." TextAlignment="Center" Style="{StaticResource Caption}" FontSize="11" Margin="0,9,0,0"/></StackPanel>
          </Border>
          <ListBox ItemsSource="{Binding Pending}">
            <ListBox.Style><Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}"><Style.Triggers><DataTrigger Binding="{Binding Busy}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></ListBox.Style>
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter HorizontalAlignment="Stretch"/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate><DataTemplate><Border Background="#1A2336" BorderBrush="#303A53" BorderThickness="1" CornerRadius="10" Padding="12"><CheckBox IsChecked="{Binding Included, Mode=TwoWay}" VerticalContentAlignment="Top"><TextBlock Text="{Binding Title}" FontSize="11" LineHeight="18" Foreground="#BCC6DB"/></CheckBox></Border></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
        </Grid>
        <StackPanel Grid.Row="2" Margin="0,18,0,0">
          <Border Background="#18322F" BorderBrush="#27504A" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,14"><TextBlock Text="Исходное значение сохраняется до изменения. Каждый результат проверяется." FontSize="10" Foreground="#8BCCBD" LineHeight="17"/></Border>
          <Button Content="Проверить и применить" Command="{Binding ApplyCommand}" Style="{StaticResource PrimaryButton}" Padding="10,13"/>
          <Button Content="Очистить очередь" Command="{Binding ClearCommand}" Style="{StaticResource QuietButton}" Margin="0,9,0,0"/>
          <TextBlock Text="Система меняется только после вашего подтверждения." Style="{StaticResource Caption}" TextAlignment="Center" FontSize="10" Margin="8,12,8,0"/>
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="1" Grid.ColumnSpan="3" Background="#111929" BorderBrush="#263147" BorderThickness="0,1,0,0" Padding="18,10">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Ellipse Width="6" Height="6" Margin="0,0,10,0" VerticalAlignment="Center"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="#69CFB8"/><Style.Triggers><DataTrigger Binding="{Binding Busy}" Value="True"><Setter Property="Fill" Value="#B49AF9"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse>
        <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="10" Foreground="#9EABC4" VerticalAlignment="Center" MaxHeight="38"/>
        <TextBlock Grid.Column="2" Text="SALSAM 2.0" FontSize="9" Foreground="#596C8B" VerticalAlignment="Center" Margin="18,0,0,0"/>
      </Grid>
    </Border>
  </Grid>
</Window>
