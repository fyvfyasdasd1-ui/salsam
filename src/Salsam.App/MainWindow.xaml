<Window x:Class="Salsam.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Salsam.App" Title="Salsam · Windows в вашем ритме" Width="1280" Height="860" MinWidth="940" MinHeight="640" Background="#0C1323" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <local:SectionVisibility x:Key="SectionVisibility"/>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#172136"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="22"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
    <Style x:Key="Title" TargetType="TextBlock"><Setter Property="FontSize" Value="25"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
    <Style x:Key="Note" TargetType="TextBlock"><Setter Property="Foreground" Value="#9BAAC5"/><Setter Property="Margin" Value="0,6,0,12"/></Style>
  </Window.Resources>
  <Window.Triggers><EventTrigger RoutedEvent="Window.Loaded"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25"/></Storyboard></BeginStoryboard></EventTrigger></Window.Triggers>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#10192B" Padding="18,28">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="8,0,0,32"><TextBlock Text="salsam" FontSize="32" FontWeight="Bold" Foreground="#A3AEFF"/><TextBlock Text="WINDOWS В ВАШЕМ РИТМЕ" FontSize="9" Foreground="#9BAAC5" Margin="0,8"/></StackPanel>
        <StackPanel DockPanel.Dock="Bottom"><TextBlock Text="Контроль вместо обещаний" Foreground="#8B9DFF"/><TextBlock Text="Изменения по вашему выбору. Измерения отдельно от предположений." Style="{StaticResource Note}" FontSize="12"/></StackPanel>
        <ListBox ItemsSource="{Binding Sections}" SelectedItem="{Binding Section}" Background="Transparent"/>
      </DockPanel>
    </Border>
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="28">
      <StackPanel>
        <TextBlock Text="{Binding Section}" FontSize="32" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBlock Text="Меньше фоновой нагрузки. Больше понимания, что меняется." Style="{StaticResource Note}"/>
        <StackPanel Visibility="{Binding Section, Converter={StaticResource SectionVisibility}, ConverterParameter=Обзор}">
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Ваш компьютер" Style="{StaticResource Title}"/><TextBlock Text="{Binding Hardware}" FontFamily="Consolas" FontSize="13"/><Button Content="Обновить сведения" Command="{Binding RefreshCommand}" HorizontalAlignment="Left"/></StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Профили" Style="{StaticResource Title}"/><TextBlock Text="Профили меняют только схему питания, если она доступна. Каждое действие можно исключить в очереди справа." Style="{StaticResource Note}"/><WrapPanel><Button Content="Сбалансированный" Command="{Binding BalancedCommand}"/><Button Content="Игры" Command="{Binding GamingCommand}"/><Button Content="Свой профиль" Command="{Binding CustomCommand}"/></WrapPanel><TextBlock Text="Профиль «Игры» выбирает существующую схему высокой производительности. На ноутбуке учитывайте батарею и нагрев. Автоматический контроль температуры не реализован." Style="{StaticResource Note}"/></StackPanel></Border>
        </StackPanel>
        <StackPanel Visibility="{Binding Section, Converter={StaticResource SectionVisibility}, ConverterParameter=Система}">
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Питание" Style="{StaticResource Title}"/><TextBlock Text="Текущая схема" Style="{StaticResource Note}"/><TextBlock Text="{Binding ActivePower}" FontSize="20"/><ComboBox ItemsSource="{Binding Plans}" SelectedItem="{Binding SelectedPlan}" Margin="0,16" Padding="8"/><TextBlock Text="Более агрессивная схема может повысить энергопотребление, температуру и шум. Поддерживаются только схемы, которые уже предоставляет Windows. Перезагрузка не требуется." Style="{StaticResource Note}"/><Button Content="Добавить в очередь" Command="{Binding QueuePowerCommand}" HorizontalAlignment="Left"/></StackPanel></Border>
        </StackPanel>
        <StackPanel Visibility="{Binding Section, Converter={StaticResource SectionVisibility}, ConverterParameter=Игры}">
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Настройки Windows" Style="{StaticResource Title}"/><TextBlock Text="Проверьте игровой режим и фоновую запись в штатном интерфейсе. Текущее состояние здесь не определяется. Управление сторонними оверлеями не реализовано." Style="{StaticResource Note}"/><WrapPanel><Button Content="Игровой режим ↗" Command="{Binding GameSettingsCommand}"/><Button Content="Запись игры ↗" Command="{Binding CaptureSettingsCommand}"/></WrapPanel><TextBlock Text="Ручные изменения в Windows не попадают в журнал Salsam. Отключение записи лишает возможности сохранить предыдущие моменты игры." Style="{StaticResource Note}"/></StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="До и после" Style="{StaticResource Title}"/><TextBlock Text="Импортируйте CSV одной игры/процесса, полученный работающим инструментом захвата. Нужен столбец FrameTimeMs или MsBetweenPresents, значения в миллисекундах с точкой; минимум 100 кадров." Style="{StaticResource Note}"/><WrapPanel><Button Content="Импорт «До»" Command="{Binding ImportBeforeCommand}"/><Button Content="Импорт «После»" Command="{Binding ImportAfterCommand}"/></WrapPanel><TextBlock Text="{Binding Before}" Foreground="#8B9DFF" Margin="0,8"/><TextBlock Text="{Binding After}" Foreground="#5DE2C4" Margin="0,8"/><Border Background="#0C1323" CornerRadius="8" Padding="10" Margin="0,12"><Viewbox Stretch="Fill" Height="180"><Canvas Width="600" Height="170"><Polyline Points="{Binding BeforePoints}" Stroke="#8B9DFF" StrokeThickness="1.4"/><Polyline Points="{Binding AfterPoints}" Stroke="#5DE2C4" StrokeThickness="1.4"/></Canvas></Viewbox></Border><TextBlock Text="{Binding GraphScale}" Style="{StaticResource Note}"/><TextBlock Text="Средний FPS = 1000 / среднее время кадра. 1% low = 1000 / среднее время самых медленных 1% кадров. Используйте одинаковые сцену, графику, разрешение и прогрев; импорт не доказывает причинную связь с оптимизацией." Style="{StaticResource Note}"/></StackPanel></Border>
        </StackPanel>
        <StackPanel Visibility="{Binding Section, Converter={StaticResource SectionVisibility}, ConverterParameter=Автозагрузка}">
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="При входе в систему" Style="{StaticResource Title}"/><TextBlock Text="Показаны записи Run текущего пользователя. Сведения об издателе взяты из файла и не подтверждают доверенность. Отключение может убрать уведомления и фоновые функции программы. Текущий процесс останется запущенным." Style="{StaticResource Note}"/><ListBox ItemsSource="{Binding Startup}" SelectedItem="{Binding SelectedStartup}" MaxHeight="360"/><WrapPanel><Button Content="Отключить выбранную · в очередь" Command="{Binding QueueStartupCommand}"/><Button Content="Все приложения в Windows ↗" Command="{Binding StartupSettingsCommand}"/></WrapPanel><TextBlock Text="Отключённую запись можно вернуть в разделе «Восстановление». Если список пуст, управляемых записей не найдено." Style="{StaticResource Note}"/></StackPanel></Border>
        </StackPanel>
        <StackPanel Visibility="{Binding Section, Converter={StaticResource SectionVisibility}, ConverterParameter=Очистка}">
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Сначала просмотр" Style="{StaticResource Title}"/><TextBlock Text="Только файлы верхнего уровня пользовательской временной папки старше 7 дней. Подкаталоги, личные документы, сохранения и кэши шейдеров не обходятся. Выбранные файлы переносятся в карантин с проверкой." Style="{StaticResource Note}"/><Button Content="Просканировать временную папку" Command="{Binding ScanCommand}" HorizontalAlignment="Left"/><ListBox ItemsSource="{Binding Temps}" SelectedItem="{Binding SelectedTemp}" MaxHeight="360"/><Button Content="Выбранный файл · в очередь" Command="{Binding QueueTempCommand}" HorizontalAlignment="Left"/><TextBlock Text="Карантин не освобождает место на том же диске. Необратимое удаление из карантина не реализовано. Занятые файлы не удаляются принудительно." Style="{StaticResource Note}"/></StackPanel></Border>
        </StackPanel>
        <StackPanel Visibility="{Binding Section, Converter={StaticResource SectionVisibility}, ConverterParameter=Мониторинг}">
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Показатели системы" Style="{StaticResource Title}"/><TextBlock Text="CPU · общая загрузка" Style="{StaticResource Note}"/><TextBlock Text="{Binding Cpu}" FontSize="42" Foreground="#8B9DFF"/><TextBlock Text="RAM · физическая память" Style="{StaticResource Note}"/><TextBlock Text="{Binding Ram}" FontSize="24" Foreground="#5DE2C4"/><TextBlock Text="Обновление каждые 2 секунды. Источник: Windows GetSystemTimes / GlobalMemoryStatusEx." Style="{StaticResource Note}"/></StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Дополнительные датчики" Style="{StaticResource Title}"/><TextBlock Text="GPU, загрузка диска и температура: сбор показателей пока не реализован. FPS и время кадра в реальном времени: захват не реализован. Для анализа используйте импорт реальных измерений в разделе «Игры»." Style="{StaticResource Note}"/></StackPanel></Border>
        </StackPanel>
        <StackPanel Visibility="{Binding Section, Converter={StaticResource SectionVisibility}, ConverterParameter=Восстановление}">
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="История изменений" Style="{StaticResource Title}"/><TextBlock Text="Исходное значение сохраняется до применения. Откат проверяет текущее состояние и не перезаписывает конфликтующие внешние изменения." Style="{StaticResource Note}"/><ListBox ItemsSource="{Binding History}" SelectedItem="{Binding SelectedRecord}" MaxHeight="330"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Target}" FontWeight="SemiBold"/><TextBlock Text="{Binding Status}" Foreground="#8B9DFF"/><TextBlock Text="{Binding Created}" FontSize="12"/><TextBlock Text="{Binding Error}" Foreground="#FFB5A7"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><WrapPanel><Button Content="Восстановить выбранное" Command="{Binding RestoreCommand}"/><Button Content="Вернуть все исходные значения" Command="{Binding RestoreAllCommand}"/></WrapPanel></StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Точки восстановления Windows" Style="{StaticResource Title}"/><TextBlock Text="Дополнительная проверка наличия точек. Создание и системное восстановление здесь не выполняются. Если доступ запрещён, журнал отдельных изменений остаётся основным способом отката." Style="{StaticResource Note}"/><Button Content="Проверить доступность" Command="{Binding RestorePointCommand}" HorizontalAlignment="Left"/><TextBlock Text="{Binding RestoreStatus}"/></StackPanel></Border>
        </StackPanel>
        <TextBlock Text="Справочник настроек" FontSize="20" Margin="0,12"/>
        <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Поиск настроек" Margin="0,0,0,14"/>
        <ItemsControl ItemsSource="{Binding FilteredSettings}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBlock Text="{Binding Description}"/><TextBlock Text="{Binding Effect}" Margin="0,8" Foreground="#5DE2C4"/><TextBlock Text="{Binding Tradeoff}" Foreground="#E8BE85"/><TextBlock Text="{Binding State}" Style="{StaticResource Note}"/><TextBlock Text="{Binding Restart}" FontSize="12"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Column="2" Background="#10192B" Padding="20,28">
      <DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="Очередь изменений" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Ничего не меняется до вашего подтверждения. Снимите галочку, чтобы исключить действие." Style="{StaticResource Note}"/></StackPanel><StackPanel DockPanel.Dock="Bottom"><Button Content="Проверить и применить" Background="#586AE8" Command="{Binding ApplyCommand}"/><Button Content="Очистить очередь" Command="{Binding ClearCommand}"/><TextBlock Text="Журнал и карантин хранятся локально в %LOCALAPPDATA%\Salsam. Не удаляйте эту папку, если нужен откат." Style="{StaticResource Note}" FontSize="12"/></StackPanel><ListBox ItemsSource="{Binding Pending}" Background="Transparent"><ListBox.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding Included}"><TextBlock Text="{Binding Title}" Width="195"/></CheckBox></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel>
    </Border>
    <Border Grid.Row="1" Grid.ColumnSpan="3" Background="#1B2740" Padding="20,12"><TextBlock Text="{Binding Status}" FontSize="12"/></Border>
  </Grid>
</Window>
